{
  "version": 3,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host / GCC / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "FW_TARGET": "host",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "f407-debug",
      "displayName": "STM32F407VE / ARM GCC / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/f407-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi.cmake",
      "cacheVariables": {
        "FW_TARGET": "stm32f407",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-asan",
      "displayName": "Host / GCC / ASan + UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-asan",
      "cacheVariables": {
        "FW_TARGET": "host",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    {"name": "host-debug", "configurePreset": "host-debug"},
    {"name": "f407-debug", "configurePreset": "f407-debug"},
    {"name": "host-asan", "configurePreset": "host-asan"}
  ],
  "testPresets": [
    {"name": "host-debug", "configurePreset": "host-debug", "output": {"outputOnFailure": true}},
    {"name": "host-asan", "configurePreset": "host-asan", "output": {"outputOnFailure": true}}
  ]
}
